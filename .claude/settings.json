{
  "permissions": {
    "deny": [
      "Edit(**/*.rs)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard-rust-writes.sh",
            "statusMessage": "Checking for Rust writes..."
          }
        ]
      }
    ]
  }
}
